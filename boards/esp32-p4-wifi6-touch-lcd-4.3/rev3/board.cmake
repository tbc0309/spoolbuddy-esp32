set(SB_BOARD_TARGET esp32p4)
set(SB_BOARD_COMPONENT sb_board)
set(SB_BOARD_COMPONENT_DIR "${CMAKE_CURRENT_LIST_DIR}/sb_board")
set(SB_BOARD_DEFAULTS "${CMAKE_CURRENT_LIST_DIR}/sdkconfig.defaults")
option(SB_ENABLE_BOOT_SLEEP "Enable this board's runtime BOOT sleep/wake button" ON)
if(SB_ENABLE_BOOT_SLEEP)
    set(SB_BOARD_FEATURE_SOURCES "${CMAKE_CURRENT_LIST_DIR}/features/boot_sleep/boot_sleep.c")
    set(SB_BOARD_FEATURE_DEFINITIONS SB_ENABLE_BOOT_SLEEP=1)
endif()
